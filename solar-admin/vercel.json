{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/kepco",
      "destination": "/api/kepco.js"
    },
    {
      "source": "/api/inquiry",
      "destination": "/api/inquiry.js"
    },
    {
      "source": "/api/inquiries",
      "destination": "/api/inquiries.js"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    }
  ]
}